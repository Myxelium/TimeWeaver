{
  "name": "weaver-app",
  "version": "0.0.0",
  "description": "A time tracking application for productivity management",
  "author": {
    "name": "Weaver Team",
    "email": "support@weaver.app"
  },
  "homepage": "https://github.com/Myxelium/TimeWeaver",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href='./' --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:weaver-app": "node dist/weaver-app/server/server.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:electron:watch": "tsc -p tsconfig.electron.json --watch",
    "electron": "npm run build:electron && electron dist/main.js",
    "electron:dev": "concurrently \"npm run build:electron:watch\" \"wait-on dist/main.js && electron dist/main.js --dev\"",
    "dev": "npm run build && npm run build:electron --development && electron dist/main.js --dev",
    "build:prod": "ng build --configuration production --base-href='./'",
    "electron:build": "npm run build:prod && npm run build:electron && electron-builder",
    "package:linux": "npm run build:prod && npm run build:electron && electron-builder --linux",
    "package:deb": "npm run build:prod && npm run build:electron && electron-builder --linux deb",
    "package:windows": "npm run build:prod && npm run build:electron && electron-builder --win",
    "package:all": "npm run build:prod && npm run build:electron && electron-builder --linux --win",
    "migration:generate": "ts-node --compiler-options '{\"module\":\"commonjs\"}' ./node_modules/typeorm/cli migration:generate ./electron/migrations/Auto -d ./electron/data-source.ts",
    "migration:create": "ts-node --compiler-options '{\"module\":\"commonjs\"}' ./node_modules/typeorm/cli migration:create ./electron/migrations/ManualMigration",
    "migration:run": "ts-node --compiler-options '{\"module\":\"commonjs\"}' ./node_modules/typeorm/cli migration:run -d ./electron/data-source.ts",
    "migration:revert": "ts-node --compiler-options '{\"module\":\"commonjs\"}' ./node_modules/typeorm/cli migration:revert -d ./electron/data-source.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/platform-server": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/ssr": "^19.2.15",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/entity": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@spartan-ng/brain": "^0.0.1-alpha.509",
    "@spartan-ng/ui-core": "^0.0.1-alpha.380",
    "@spartan-ng/ui-forms-brain": "^0.0.1-alpha.374",
    "@spartan-ng/ui-label-brain": "^0.0.1-alpha.374",
    "date-fns": "^4.1.0",
    "express": "^4.18.2",
    "lucide-angular": "^0.542.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "sql.js": "^1.13.0",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.26",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.0",
    "@electron/rebuild": "^4.0.1",
    "@electron/remote": "^2.1.3",
    "@ngrx/store-devtools": "^19.2.1",
    "@spartan-ng/cli": "^0.0.1-alpha.509",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.123",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.2",
    "wait-on": "^8.0.4"
  },
  "main": "dist/main.js",
  "build": {
    "appId": "com.weaver.timetracking",
    "productName": "Weaver",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.map"
    ],
    "asarUnpack": [
      "dist/main.js",
      "dist/entities/**/*"
    ],
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "weaver-app",
      "executableArgs": [
        "--no-sandbox"
      ],
      "maintainer": "Weaver Team <support@weaver.app>",
      "synopsis": "Time tracking application for productivity management"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
